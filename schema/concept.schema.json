{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gob.local/schema/concept.schema.json",
  "title": "概念分片文件",
  "description": "约束 concepts.yaml；concept 定义只在此处声明一次，供 objects.yaml 与叶子文件复用。",
  "type": "object",
  "required": ["concepts"],
  "additionalProperties": false,
  "properties": {
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/concept"
      }
    }
  },
  "definitions": {
    "concept": {
      "type": "object",
      "required": ["id", "canonical_name", "description", "parents", "sources", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^concept_[0-9a-f]{12}$"
        },
        "canonical_name": {
          "$ref": "common.schema.json#/definitions/name"
        },
        "description": {
          "$ref": "common.schema.json#/definitions/description"
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/definitions/concept_ref"
          },
          "description": "直接父概念 ID 列表；顶层概念为空数组"
        },
        "sources": {
          "$ref": "common.schema.json#/definitions/sources"
        },
        "created_at": {
          "$ref": "common.schema.json#/definitions/created_at"
        },
        "supply": {
          "$ref": "supply.schema.json"
        }
      }
    }
  }
}
