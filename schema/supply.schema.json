{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gob.local/schema/supply.schema.json",
  "title": "supply 扩展字段",
  "description": "面向下游需求的扩展字段；只接收已知键，未知键视为错误。",
  "type": "object",
  "properties": {
    "need": {
      "type": "string",
      "enum": ["all-children", "none"],
      "description": "对象供给的作用域范围"
    },
    "assertion_key": {
      "type": "string",
      "minLength": 1,
      "description": "断言标识，仅 KE 使用；相同标识表示在不同层说同一件事，用于冲突求值"
    },
    "effective_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "生效日期，仅 KE 使用；用于时间过滤与冲突求值的次序判断"
    },
    "is_pure": {
      "type": "boolean",
      "description": "算子纯性：相同输入是否始终得到相同输出"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "知识置信度"
    },
    "extractor": {
      "type": "string",
      "minLength": 1,
      "description": "抽取方：模型名与版本，或人工标注者"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "description": "复核人"
    }
  },
  "additionalProperties": false
}
